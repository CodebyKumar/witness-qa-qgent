# TinyFish API key from https://agent.tinyfish.ai/api-keys (required)
TINYFISH_API_KEY=
# Groq key for the planner and verifier (required), from https://console.groq.com/keys
GROQ_API_KEY=
# Optional: models tried in order; a rate limit (429) or unavailable model falls through to the next
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
TF_CONCURRENCY=2
TF_MAX_DURATION_S=240
# Set to true only if your TinyFish account is in the strict-mode / max_steps beta
TF_STRICT_BETA=false
# Public URL of the deployed demo-site/ folder (TinyFish cannot reach localhost)
NEXT_PUBLIC_DEMO_URL=
